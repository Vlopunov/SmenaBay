{
  "expo": {
    "name": "СменаБел",
    "slug": "SmenaBay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "СменаБел — платформа подработок и посменной работы в Беларуси. Для соискателей — быстрый поиск смен рядом. Для работодателей — публикация вакансий и отбор кандидатов.",
    "primaryColor": "#0F5673",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smenabay.app",
      "buildNumber": "4",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "СменаБел использует камеру, чтобы вы могли сделать и загрузить фото профиля или прикрепить снимок в чат.",
        "NSPhotoLibraryUsageDescription": "СменаБел запрашивает доступ к фото, чтобы вы могли установить фото профиля и отправлять изображения в чат.",
        "NSPhotoLibraryAddUsageDescription": "Разрешите сохранять изображения из приложения в вашу фотогалерею."
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F5673"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.smenabay.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 15,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFC89E",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#243459"
          },
          "ios": {
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 120,
            "resizeMode": "contain",
            "backgroundColor": "#FBF8F4",
            "dark": {
              "image": "./assets/splash-icon-dark.png",
              "backgroundColor": "#11161C"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F5673",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "СменаБел запрашивает доступ к фото, чтобы вы могли установить фото профиля и отправлять изображения в чат.",
          "cameraPermission": "СменаБел использует камеру, чтобы вы могли сделать и загрузить фото профиля или прикрепить снимок в чат.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "./plugins/with-adi-registration.js",
      "./plugins/with-non-modular-includes.js",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec9c0ac8-1eb1-4cbf-9bf9-ed3293f23607"
      }
    },
    "owner": "lopunow"
  }
}
