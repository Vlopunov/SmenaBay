      "family": "text",
      "weight": 700,
      "size": 17.5,
      "line": 17.5,
      "ax3": {
        "size": 24,
        "line": 26,
        "$note": "кнопка становится двухстрочной, высота 54 → 76"
      }
    },
    "$ax3": {
      "policy": "Кегль растёт, кроме money.hero и countdown — они растут медленнее (×1.17), иначе сумма ломает строку. Все контейнеры по высоте — hug, никаких фиксированных высот у текстовых блоков. Ряд «икона + текст + сумма» на AX3 переходит в две строки."
    }
