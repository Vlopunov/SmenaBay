  "motion": {
    "$rule": "Анимируются только transform и opacity. У каждого токена есть вариант для Reduce Motion.",
    "timing.press": {
      "purpose": "нажатие",
      "scale": 0.97,
      "duration": 120,
      "curve": "cubic-bezier(.23,1,.32,1)",
      "haptic": null,
      "reduced": "opacity .92"
    },
    "timing.fade": {
      "purpose": "смена режима",
      "duration": 200,
      "curve": "ease-out",
      "haptic": null,
      "reduced": "как есть"
    },
    "timing.number": {
      "purpose": "отсчёт",
      "duration": "400–600",
      "curve": "ease-out",
      "haptic": null,
      "reduced": "мгновенная подстановка"
    },
    "spring.snappy": {
      "purpose": "морф · выбор",
      "stiffness": 250,
      "damping": 1,
      "haptic": "success | selection",
      "reduced": "кросс-фейд 200 мс"
    },
    "spring.default": {
      "purpose": "переход",
      "stiffness": 400,
      "damping": 1,
      "haptic": null,
      "reduced": "кросс-фейд 200 мс"
    },
    "spring.sheet": {
      "purpose": "лист",
      "stiffness": 300,
      "damping": 0.8,
      "haptic": "light на detent",
      "reduced": "кросс-фейд 200 мс"
    },
    "shake": {
      "purpose": "отказ",
      "duration": 450,
      "cycles": 2,
      "amplitude": 7,
      "haptic": "error",
      "reduced": "тряски нет, тост + красная рамка 200 мс"
    },
    "celebrate": {
      "purpose": "праздник",
      "duration": 800,
      "once": true,
      "haptic": "success",
      "reduced": "статичная карточка, фейд 200 мс",
      "$rule": "Только «Все места закрыты» у заказчика."
    }
  },
  "haptic": {
